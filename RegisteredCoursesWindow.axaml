<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="s.RegisteredCoursesWindow"
        Title="My Registered Courses"
        Width="700"
        Height="550">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25"
                    Spacing="15">

            <!-- =========================
                 HEADER
                 ========================= -->

            <TextBlock Text="MY REGISTERED COURSES"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="View the courses you have previously registered."
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>

            <Separator/>

            <!-- =========================
                 INFORMATION
                 ========================= -->

            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">

                <StackPanel Spacing="6">

                    <TextBlock Text="Registration Records"
                               FontSize="17"
                               FontWeight="Bold"/>

                    <TextBlock Text="The list below shows your registered courses and their current registration details."
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

            <!-- =========================
                 COURSE LIST
                 ========================= -->

            <TextBlock Text="Registered Courses"
                       FontSize="18"
                       FontWeight="Bold"/>

            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">

                <ListBox Name="RegisteredCoursesList"
                         Height="350"/>

            </Border>

            <!-- =========================
                 NOTE
                 ========================= -->

            <TextBlock Text="Course status and registration date are shown for each registered course."
                       FontStyle="Italic"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <!-- =========================
                 CLOSE
                 ========================= -->

            <Button Content="Close"
                    Width="120"
                    Height="40"
                    HorizontalAlignment="Center"
                    Click="OnCloseClick"/>

        </StackPanel>

    </ScrollViewer>

</Window>

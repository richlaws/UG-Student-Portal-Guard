<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="s.ProofWindow"
        Width="600"
        Height="500"
        Title="Proof of Registration"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="10">

            <TextBlock Text="UNIVERSITY OF GHANA"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="PROOF OF REGISTRATION"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,20"/>

            <TextBlock Name="StudentInfoText"
                       FontSize="14"
                       TextWrapping="Wrap"/>

            <TextBlock Name="CourseText"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"/>

            <Button Content="Close"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Click="OnCloseClick"/>

        </StackPanel>
    </ScrollViewer>

</Window>
